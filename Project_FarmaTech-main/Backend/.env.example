## MediGuard Backend — Local Configuration
## Copy this file to Backend/.env and fill in real values.
## NEVER commit Backend/.env to Git — it is excluded by .gitignore.

# ─── AI Provider ──────────────────────────────────────────────────────────────
# Choose "groq" (default) or "gemini".
AI_PROVIDER=groq

# ─── Groq API Key (required when AI_PROVIDER=groq) ───────────────────────────
GROQ_API_KEY=

# ─── Gemini API Key (required when AI_PROVIDER=gemini) ───────────────────────
GEMINI_API_KEY=

# ─── Optional backend API Key (leave blank to disable key-checking) ───────────
API_KEY=

# ─── Session signing secret ────────────────────────────────────────────────────
# Generate a strong value:  python -c "import secrets; print(secrets.token_hex(32))"
# Leave blank only for local throwaway testing — sessions will not survive restarts.
AUTH_SECRET=

# ─── SQLite account database path ─────────────────────────────────────────────
# A relative path is resolved relative to the Backend/ directory.
# Leave as "auth.db" to use Backend/auth.db (already excluded from Git).
AUTH_DB_PATH=auth.db

# ─── CORS allowed origins ─────────────────────────────────────────────────────
# Comma-separated list of frontend origins allowed in production.
# Use "*" only for local development.
ALLOWED_ORIGINS=http://localhost:5173

# ─── Optional: set to "true" in production (HTTPS only) ──────────────────────
AUTH_COOKIE_SECURE=false
